rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Wallet balances and ledger are server-only; Admin SDK writes bypass these rules.
    match /wallets/{uid} {
      allow read, write: if false;
      match /transactions/{transactionId} {
        allow read, write: if false;
      }
    }

    match /users/{uid} {
      allow read, create, update, delete: if owns(uid);

      match /kyc/{documentId} {
        allow read, create, update: if owns(uid);
        allow delete: if false;
      }

      match /notifications/{notificationId} {
        allow read: if owns(uid);
        // Notifications are created by trusted server/Admin SDK only.
        allow write: if false;
      }

      match /orders/{orderId} {
        // Orders are written by the authenticated backend using Admin SDK.
        allow read: if owns(uid);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
